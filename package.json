{
  "name": "equinox-rota",
  "description": "Türkçe anime keşif, takip ve kişisel arşiv deneyimi.",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "Samet Başbuğ",
  "homepage": "https://anime.sametbasbug.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sametbasbug/anime.sametbasbug.dev.git"
  },
  "bugs": {
    "url": "https://github.com/sametbasbug/anime.sametbasbug.dev/issues"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "keywords": [
    "anime",
    "astro",
    "equinox",
    "supabase",
    "turkish"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "npm run check && astro build",
    "preview": "astro preview",
    "check": "npm run catalogue:check && npm run content:check && npm run source:check && npm run dialogue:check && npm run sync:check && npm run journal:check && npm run collections:check && npm run discovery:check && npm run season:check && npm run yearbook:check && npm run auth:check && npm run agent:check && npm run community:check && npm run sharing:check && npm run statistics:check && npm run portability:check && astro check",
    "catalogue:check": "tsx scripts/check-kitsu-catalogue.ts",
    "kitsu:media-check": "node scripts/check-kitsu-media.mjs",
    "content:check": "node scripts/check-editorial.mjs",
    "source:check": "tsx scripts/check-source-labels.ts",
    "dialogue:check": "tsx scripts/check-rota-dialogue.ts",
    "sync:check": "tsx scripts/check-personal-list-sync.ts",
    "journal:check": "tsx scripts/check-watch-journal.ts",
    "collections:check": "tsx scripts/check-personal-collections.ts",
    "discovery:check": "tsx scripts/check-personal-discovery.ts",
    "season:check": "tsx scripts/check-season-board.ts",
    "yearbook:check": "tsx scripts/check-rota-yearbook.ts",
    "data:refresh": "node scripts/refresh-catalogue.mjs",
    "data:identities": "node scripts/refresh-catalogue-identities.mjs",
    "auth:check": "tsx scripts/check-orbit-signin.ts",
    "agent:check": "node supabase/functions/orbit-eylem/jwt-tests.ts && tsx supabase/functions/orbit-eylem/action-tests.ts",
    "community:check": "tsx scripts/check-community.ts",
    "sharing:check": "tsx scripts/check-profile-sharing.ts",
    "statistics:check": "tsx scripts/check-personal-statistics.ts",
    "portability:check": "tsx scripts/check-list-portability.ts"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@supabase/supabase-js": "^2.112.3",
    "astro": "^7.2.2",
    "fast-xml-parser": "^5.11.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
