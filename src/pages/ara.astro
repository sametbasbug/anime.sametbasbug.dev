---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SearchExperience from "../components/SearchExperience";
import DataAttribution from "../components/DataAttribution.astro";
import { catalogueMeta } from "../lib/catalogue";
---

<BaseLayout title="Anime kataloğu — Equinox Rota" description="Anime adı, tür, stüdyo veya yıla göre Türkçe katalogda ara.">
  <SiteHeader active="search" />
  <main class="catalogue-page">
    <section class="catalogue-hero">
      <p class="eyebrow">AÇIK KATALOG · {catalogueMeta.entryCount} YAPIM</p>
      <h1>Bugün ne izlemek istersin?</h1>
      <p>Anime adıyla ara veya tür, yayın durumu ve format filtreleriyle seçenekleri daralt.</p>
      <div class="catalogue-hero__links"><a href="/tur">Türlere göz at ↗</a><a href="/studyo">Stüdyoları keşfet ↗</a></div>
    </section>
    <SearchExperience dataVersion={catalogueMeta.generatedAt} client:load />
    <DataAttribution />
  </main>
</BaseLayout>
