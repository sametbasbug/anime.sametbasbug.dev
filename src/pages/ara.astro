---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SearchExperience from "../components/SearchExperience";
import RotaCompanion from "../components/RotaCompanion";
import DataAttribution from "../components/DataAttribution.astro";
import { catalogueMeta, posterMeta } from "../lib/catalogue";
---

<BaseLayout title="Anime kataloğu — Equinox Rota" description="Anime adı, tür, stüdyo veya yıla göre Türkçe katalogda ara.">
  <SiteHeader active="search" />
  <main class="catalogue-page">
    <section class="catalogue-hero">
      <RotaCompanion message="Ne arıyoruz?" mood="curious" className="rota-companion--catalogue" />
      <p class="eyebrow">KEŞİF MODU · {catalogueMeta.entryCount} ANİME</p>
      <h1>Yeni bir dünyaya dal ✦</h1>
      <p>Ruh halini, sevdiğin türü veya aklındaki animeyi yaz. Rota sana uygun rafı açsın.</p>
      <div class="catalogue-hero__links"><a href="/tur">Türlere göz at ↗</a><a href="/studyo">Stüdyoları keşfet ↗</a></div>
    </section>
    <SearchExperience dataVersion={`${catalogueMeta.generatedAt}-${posterMeta.generatedAt}`} client:load />
    <DataAttribution />
  </main>
</BaseLayout>
