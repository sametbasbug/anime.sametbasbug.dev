---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import AccountExperience from "../components/AccountExperience";
import { catalogueMeta } from "../lib/catalogue";
---

<BaseLayout title="Hesap — Equinox Rota" description="Equinox Rota hesabını, cihazlar arası senkronizasyonu ve liste gizliliğini yönet.">
  <SiteHeader active="account" />
  <main class="account-page">
    <section class="account-hero">
      <div>
        <p class="eyebrow">PROFİL · RAF · SENKRONİZASYON</p>
        <h1>Burası senin <em>köşen.</em></h1>
        <p>Anime yolculuğunu kişiselleştir, rafını yanında taşı ve görünürlüğünü kendin seç.</p>
      </div>
      <div class="account-hero__badge" aria-hidden="true">
        <span>✦</span>
        <strong>ROTA CLUB</strong>
        <small>LOCAL-FIRST MEMBER</small>
      </div>
    </section>
    <section class="account-experience">
      <AccountExperience dataVersion={catalogueMeta.generatedAt} client:load />
    </section>
  </main>
</BaseLayout>
