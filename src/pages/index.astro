---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import AnimeArtwork from "../components/AnimeArtwork";
import SeasonShelf from "../components/SeasonShelf";
import HomeLibrarySummary from "../components/HomeLibrarySummary";
import RotaCompanion from "../components/RotaCompanion.astro";
import {
  catalogue,
  displayTags,
  preferredAliases,
  seasonLabels,
  typeLabels,
  visualFor,
  type CatalogueAnime,
} from "../lib/catalogue";

const now = new Date();
const currentYear = now.getFullYear();
const currentSeason = now.getMonth() < 3 ? "WINTER" : now.getMonth() < 6 ? "SPRING" : now.getMonth() < 9 ? "SUMMER" : "FALL";

function statusSelection(status: CatalogueAnime["status"]) {
  const seen = new Set<string>();
  return catalogue
    .filter((anime) => anime.season.year === currentYear && anime.status === status && ["TV", "ONA", "MOVIE"].includes(anime.type))
    .sort((a, b) => (b.sources.length * 2 + (b.score ?? 0)) - (a.sources.length * 2 + (a.score ?? 0)))
    .filter((anime) => {
      const key = anime.title.toLocaleLowerCase("tr-TR");
      if (seen.has(key)) return false;
      seen.add(key);
      return true;
    })
    .slice(0, 4);
}

const homepageAnime = ["ONGOING", "FINISHED", "UPCOMING"].flatMap((status) => statusSelection(status));
const featured = statusSelection("ONGOING")[0] ?? homepageAnime[0] ?? catalogue[0];
const featuredVisual = visualFor(featured.id);
const featuredAlias = preferredAliases(featured.synonyms, 1)[0];
const featuredTags = displayTags(featured.tags, 2);
const moodRoutes = [
  { icon: "♡", label: "Kalp çarptıran", note: "Romantizm", href: "/ara?q=romantizm", tone: "pink" },
  { icon: "✦", label: "Başka dünyalar", note: "Isekai & fantazi", href: "/ara?q=fantazi", tone: "violet" },
  { icon: "☀", label: "İç ısıtan", note: "Gündelik yaşam", href: "/ara?q=gündelik yaşam", tone: "yellow" },
  { icon: "⚡", label: "Nabız yükselten", note: "Aksiyon", href: "/ara?q=aksiyon", tone: "blue" },
  { icon: "☾", label: "Geceye gizem", note: "Gizem & gerilim", href: "/ara?q=gizem", tone: "mint" },
];
---

<BaseLayout title="Equinox Rota — Anime yolculuğunun kaydı" description="Equinox Rota, Türkçe anime keşif, takip ve kişisel arşiv ürünüdür. Animeleri keşfet, listeni kur ve kendi rotanı oluştur.">
  <SiteHeader active="discover" />

  <main>
    <section class="hero home-hero" id="kesfet">
      <div class="hero__copy">
        <p class="eyebrow"><span>{seasonLabels[currentSeason]} {currentYear}</span> SENİN ANİME YOLCULUĞUN</p>
        <h1>Sıradaki favorini <em>bul.</em></h1>
        <p class="hero__lede">Yeni dünyalar keşfet, izlediklerini kendi rafına ekle ve kaldığın bölümü bir daha unutma.</p>
        <form class="home-search" action="/ara" method="get" role="search">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8" /><path d="m16 16 4.4 4.4" /></svg>
          <input name="q" type="search" placeholder="Anime, tür veya stüdyo ara" aria-label="Anime ara" />
          <button type="submit">Keşfet <span>✦</span></button>
        </form>
        <div class="hero__quick-links" aria-label="Hızlı keşif">
          <span>Şu an ne izlesek?</span>
          <a href="/ara?q=romantizm">Romantizm</a>
          <a href="/ara?q=aksiyon">Aksiyon</a>
          <a href="/ara?q=fantazi">Fantazi</a>
        </div>
      </div>

      <div class="hero__visual">
        <RotaCompanion message="Bir bölüm daha?" mood="happy" className="rota-companion--hero" />
        <span class="hero-sticker hero-sticker--top">YENİ<br />KEŞİF!</span>
        <span class="hero-doodle hero-doodle--star" aria-hidden="true">✦</span>
        <span class="hero-doodle hero-doodle--heart" aria-hidden="true">♡</span>
        <a class="feature-card" href={`/anime/${featured.slug}`} aria-label={`${featured.title} detayına git`}>
          <AnimeArtwork art={featuredVisual.art} palette={featuredVisual.palette} />
          <div class="feature-card__shade"></div>
          <div class="feature-card__top">
            <span class="airing"><i></i> HAFTANIN ROTASI</span>
            {featured.score && <span class="feature-score">★ {featured.score.toFixed(1)}</span>}
          </div>
          <div class="feature-card__copy">
            <p>{featuredAlias ?? `${typeLabels[featured.type]} · ${seasonLabels[featured.season.season]} ${featured.season.year}`}</p>
            <h2>{featured.title}</h2>
            <div>{featuredTags.map((tag) => <span>{tag}</span>)}<span>{featured.episodes || "?"} BÖLÜM</span></div>
          </div>
        </a>
      </div>
    </section>

    <HomeLibrarySummary client:load />

    <section class="schedule mood-section" id="harita">
      <div class="section-heading">
        <div><p class="eyebrow">RUH HALİNE GÖRE</p><h2>Bugün hangi dünyaya gidelim?</h2></div>
        <a href="/ara">Tüm kataloğu aç <span>→</span></a>
      </div>
      <div class="catalogue-strip mood-grid">
        {moodRoutes.map((item) => (
          <a href={item.href} class={`mood-card mood-card--${item.tone}`}>
            <strong>{item.icon}</strong><span>{item.label}</span><small>{item.note} →</small>
          </a>
        ))}
      </div>
    </section>

    <section class="season" id="sezon">
      <div class="section-heading section-heading--season">
        <div><p class="eyebrow">SEZON RAFI · {currentYear}</p><h2>Radarımıza takılanlar ✦</h2></div>
        <p class="section-intro">Devam edenler, yeni tamamlananlar ve yaklaşan dünyalardan taze bir seçki.</p>
      </div>
      <SeasonShelf items={homepageAnime} client:load />
    </section>

    <section class="manifesto fan-space" id="listeler">
      <div><p class="eyebrow">SENİN OTAKU KÖŞEN</p><h2>Listen, senin hikâyen.</h2><p class="fan-space__lede">Rota yalnız ne izlediğini değil, o dünyalarda nerede kaldığını da hatırlar.</p></div>
      <div class="manifesto__grid">
        <article><span>EP.01</span><b aria-hidden="true">▶</b><h3>Kaldığın bölüme dön</h3><p>İlerlemeni tek dokunuşla güncelle.</p></article>
        <article><span>EP.02</span><b aria-hidden="true">☁</b><h3>Rafın yanında gelsin</h3><p>İstersen Google hesabınla cihazlarında eşitle.</p></article>
        <article><span>EP.03</span><b aria-hidden="true">♡</b><h3>Notların sana kalsın</h3><p>Puanlarını ve anılarını kendi köşende tut.</p></article>
      </div>
      <a class="manifesto__cta" href="/listem">Kendi rafımı aç <span>✦</span></a>
    </section>
  </main>

</BaseLayout>
