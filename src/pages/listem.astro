---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import MyListExperience from "../components/MyListExperience";
import DataAttribution from "../components/DataAttribution.astro";
import { catalogueMeta } from "../lib/catalogue";
---

<BaseLayout title="Listem — Equinox Rota" description="İzlediğin, tamamladığın ve daha sonra izlemek istediğin animeleri kişisel arşivinde tut.">
  <SiteHeader active="lists" />
  <main class="my-list-page">
    <section class="my-list-hero">
      <div>
        <p class="eyebrow">KİŞİSEL ARŞİV · ÖNCE BU CİHAZDA</p>
        <h1>Listem</h1>
      </div>
      <p>İzlediklerini, sıradakileri ve yarım kalanları tek yerde yönet. Bölüm ilerlemeni buradan anında güncelle.</p>
    </section>
    <section class="my-list-experience">
      <MyListExperience dataVersion={catalogueMeta.generatedAt} client:load />
    </section>
    <DataAttribution />
  </main>
</BaseLayout>
