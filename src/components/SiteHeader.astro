---
import AccountStatus from "./AccountStatus";
import RotaMark from "./RotaMark.astro";

interface Props {
  active?: "discover" | "search" | "season" | "picker" | "guides" | "lists" | "collections" | "journal" | "yearbook" | "account" | "none";
}

const { active = "discover" } = Astro.props;

const sectionLinks = [
  { key: "discover", href: "/", label: "Ana", description: "Kişisel dönüş ve güncel seçkiler" },
  { key: "search", href: "/ara", label: "Keşfet", description: "Katalog, tür ve stüdyo yolları" },
  { key: "season", href: "/sezonlar", label: "Sezonlar", description: "Yeni, devam eden ve yaklaşanlar" },
  { key: "picker", href: "/oneriler", label: "Bana seç", description: "Açıklanabilir kişisel öneriler" },
  { key: "guides", href: "/rehberler", label: "Rehberler", description: "Türkçe seçkiler ve odak yazıları" },
  { key: "lists", href: "/listem", label: "Listem", description: "İzleme durumun ve ilerlemen" },
  { key: "collections", href: "/koleksiyonlar", label: "Koleksiyonlar", description: "Kendi tematik anime rafların" },
  { key: "journal", href: "/gunluk", label: "Günlük", description: "Bölüm kayıtların ve aylık özet" },
  { key: "yearbook", href: "/yillik", label: "Yıllık", description: "Aylık ve yıllık anime yolculuğun" },
] as const;

const mobileMoreActive = ["season", "picker", "guides", "collections", "yearbook"].includes(active);
---

<header class="site-header">
  <a href="/" class="brand" aria-label="Equinox Rota ana sayfa">
    <RotaMark />
    <span>Rota<small>BY EQUINOX</small></span>
  </a>

  <nav class="desktop-nav" aria-label="Ana menü">
    {sectionLinks.map((item) => (
      <a class:list={{ "is-active": active === item.key }} href={item.href}>{item.label}</a>
    ))}
  </nav>

  <div class="header-actions">
    <a class="header-search" href="/ara" aria-label="Anime ara">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8" /><path d="m16 16 4.4 4.4" /></svg>
      <span>Anime ara</span>
    </a>
    <AccountStatus client:load />
  </div>
</header>

<nav class="mobile-nav" aria-label="Mobil ana menü">
  <a class:list={{ "is-active": active === "discover" }} href="/">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 10.5 12 3l8.5 7.5v9a1.5 1.5 0 0 1-1.5 1.5H5a1.5 1.5 0 0 1-1.5-1.5Z" /><path d="M9 21v-7h6v7" /></svg>
      <span>Ana</span>
  </a>
  <a class:list={{ "is-active": active === "search" || active === "season" || active === "picker" || active === "guides" }} href="/ara">
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m15.5 15.5 5 5" /></svg>
    <span>Keşfet</span>
  </a>
  <a class:list={{ "is-active": active === "lists" || active === "collections" }} href="/listem">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4h12v17l-6-3.7L6 21Z" /></svg>
    <span>Listem</span>
  </a>
  <a class:list={{ "is-active": active === "journal" || active === "yearbook" }} href="/gunluk">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3.5h10.5A1.5 1.5 0 0 1 18 5v15.5H7.5A1.5 1.5 0 0 1 6 19Z" /><path d="M6 18.5A1.5 1.5 0 0 1 7.5 17H18M9 8h6M9 11.5h5" /></svg>
    <span>Günlük</span>
  </a>
  <details class:list={["mobile-more", { "is-active": mobileMoreActive }]}>
    <summary aria-label="Tüm Rota bölümlerini aç">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1.5" /><circle cx="12" cy="12" r="1.5" /><circle cx="19" cy="12" r="1.5" /></svg>
      <span>Menü</span>
    </summary>
    <section class="mobile-more__sheet" aria-label="Tüm Rota bölümleri">
      <header>
        <div><small>ROTA MENÜSÜ</small><strong>Tüm duraklar</strong></div>
        <span>Bir bölüme dokun ve yoluna devam et.</span>
      </header>
      <div class="mobile-more__grid">
        {sectionLinks.map((item) => (
          <a class:list={{ "is-active": active === item.key }} href={item.href}>
            <strong>{item.label}</strong>
            <small>{item.description}</small>
          </a>
        ))}
      </div>
    </section>
  </details>
</nav>

<script>
  const closeMobileMenus = (except?: Node | null) => {
    document.querySelectorAll<HTMLDetailsElement>(".mobile-more[open]").forEach((menu) => {
      if (!except || !menu.contains(except)) menu.removeAttribute("open");
    });
  };

  document.addEventListener("click", (event) => closeMobileMenus(event.target as Node));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMobileMenus();
  });
</script>
