---
interface Props {
  message?: string;
  mood?: "happy" | "curious" | "sleepy";
  className?: string;
}

const { message = "Bir bölüm daha?", mood = "happy", className = "" } = Astro.props;
---

<div class:list={["rota-companion", `rota-companion--${mood}`, className]} aria-hidden="true">
  <span class="rota-companion__bubble">{message}</span>
  <span class="rota-companion__body">
    <i class="rota-companion__eyes"></i>
    <i class="rota-companion__blush"></i>
    <i class="rota-companion__mouth"></i>
    <b>✦</b>
  </span>
</div>
